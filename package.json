{
  "name": "project-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-next-lock.mjs next dev",
    "build": "node scripts/with-next-lock.mjs next build --webpack",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:e2e:phase3": "node scripts/test-phase3-e2e.mjs",
    "test:e2e:phase4": "node scripts/test-phase4-security.mjs",
    "test:e2e:phase5": "node scripts/test-phase5-reliability.mjs",
    "test:e2e:phase7": "node scripts/test-phase7-ux.mjs",
    "test:smoke": "node scripts/smoke-release.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "data:export": "node scripts/portable-data.mjs export",
    "data:import": "node scripts/portable-data.mjs import",
    "postinstall": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@sparticuz/chromium": "^147.0.2",
    "next": "^16.3.5",
    "openai": "^5.20.2",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.3",
    "prettier": "^3.9.8",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
