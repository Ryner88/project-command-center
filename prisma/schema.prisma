generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  SENT
  WON
  LOST
}

enum ProposalSeedSourceType {
  EMAIL
  BRIEFING
  MANUAL
}

enum ProposalDomain {
  WEBSITE
  SAAS_SOFTWARE
  EDUCATION_SCHOOL
  MEDICAL_HEALTHCARE
  INTERNAL_TOOL
  FINANCE
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum WorkPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  briefingItems BriefingItem[]
  proposalSeeds ProposalSeed[]
  proposals     Proposal[]
  exports       Export[]
  projects      Project[]
  tasks         Task[]
  proposalVersions ProposalVersion[]
  auditEvents   AuditEvent[]
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, entityType, entityId])
}

model BriefingItem {
  id             String   @id @default(cuid())
  userId         String
  title          String
  summary        String
  source         String
  requiresAction Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProposalSeed {
  id              String                 @id @default(cuid())
  userId          String
  sourceType      ProposalSeedSourceType
  sourceReference String?
  clientName      String?
  projectType     String?
  projectDomain   ProposalDomain?
  projectDomainOther String?
  summary         String
  context         Json
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  archivedAt      DateTime?
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals       Proposal[]
  @@unique([userId, id])
  @@index([userId, createdAt])
}

model Proposal {
  id             String         @id @default(cuid())
  userId         String
  proposalSeedId String?
  projectId      String?
  title          String
  clientName     String
  projectType    String?
  projectDomain  ProposalDomain?
  projectDomainOther String?
  status         ProposalStatus @default(DRAFT)
  startDate      String?
  dueDate        String?
  summary        String
  scope          Json
  deliverables   Json
  taskBreakdown  Json
  timeline       String?
  risks          Json
  assumptions    Json
  priceRange     String
  sourceLabel    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalSeed   ProposalSeed?  @relation(fields: [proposalSeedId], references: [id], onDelete: SetNull)
  project        Project?       @relation(fields: [userId, projectId], references: [userId, id], onDelete: SetNull)
  exports        Export[]
  versions       ProposalVersion[]
  @@unique([userId, id])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  clientName  String
  description String
  status      ProjectStatus @default(PLANNING)
  priority    WorkPriority  @default(MEDIUM)
  startDate   String?
  dueDate     String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals   Proposal[]
  tasks       Task[]
  @@unique([userId, id])
  @@index([userId, archivedAt, priority, updatedAt])
  @@index([userId, status, updatedAt])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  projectId   String
  title       String
  description String?
  priority    WorkPriority @default(MEDIUM)
  position    Int          @default(0)
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [userId, projectId], references: [userId, id], onDelete: Cascade)
  @@index([userId, projectId, completedAt, position])
}

model ProposalVersion {
  id         String   @id @default(cuid())
  userId     String
  proposalId String
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal   Proposal @relation(fields: [userId, proposalId], references: [userId, id], onDelete: Cascade)
  @@unique([proposalId, version])
  @@index([userId, proposalId, createdAt])
}

model Export {
  id         String   @id @default(cuid())
  userId     String
  proposalId String   @unique
  fileName   String
  filePath   String
  mimeType   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
